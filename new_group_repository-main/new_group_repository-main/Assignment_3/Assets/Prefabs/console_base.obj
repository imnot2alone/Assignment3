# console_base.obj
# 简单长方体底座，底边在 y=0，高度1

o console_base

v -0.4 0.0 -0.3
v  0.4 0.0 -0.3
v  0.4 1.0 -0.3
v -0.4 1.0 -0.3
v -0.4 0.0  0.3
v  0.4 0.0  0.3
v  0.4 1.0  0.3
v -0.4 1.0  0.3

# 前 (+Z)
f 5 6 7 8
# 后 (-Z)
f 2 1 4 3
# 左 (-X)
f 1 5 8 4
# 右 (+X)
f 2 6 7 3
# 上 (+Y)
f 4 3 7 8
# 下 (-Y)
f 1 2 6 5
