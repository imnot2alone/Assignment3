# console_panel.obj
# 薄面板，用作显示/控制区域

o console_panel

v -0.3 0.0 -0.025
v  0.3 0.0 -0.025
v  0.3 0.4 -0.025
v -0.3 0.4 -0.025
v -0.3 0.0  0.025
v  0.3 0.0  0.025
v  0.3 0.4  0.025
v -0.3 0.4  0.025

# 前 (+Z)
f 5 6 7 8
# 后 (-Z)
f 2 1 4 3
# 左 (-X)
f 1 5 8 4
# 右 (+X)
f 2 6 7 3
# 上 (+Y)
f 4 3 7 8
# 下 (-Y)
f 1 2 6 5
